{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.powerchain.ventures/readiness.schema.json",
  "title": "PowerChain Launch Readiness",
  "type": "object",
  "required": ["launchId", "score", "checks", "blockingIssues"],
  "properties": {
    "launchId": { "type": "string", "minLength": 1 },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "blockingIssues": { "type": "integer", "minimum": 0 },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "state"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "state": { "enum": ["pass", "attention", "blocked"] },
          "href": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
