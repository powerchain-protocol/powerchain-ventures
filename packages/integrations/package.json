{
  "name": "@powerchain/integrations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./amount": {
      "types": "./dist/amount.d.ts",
      "import": "./dist/amount.js",
      "default": "./dist/amount.js"
    },
    "./rates": {
      "types": "./dist/rates.d.ts",
      "import": "./dist/rates.js",
      "default": "./dist/rates.js"
    },
    "./pyth": {
      "types": "./dist/pyth.d.ts",
      "import": "./dist/pyth.js",
      "default": "./dist/pyth.js"
    },
    "./birdeye": {
      "types": "./dist/birdeye.d.ts",
      "import": "./dist/birdeye.js",
      "default": "./dist/birdeye.js"
    },
    "./coinmarketcap": {
      "types": "./dist/coinmarketcap.d.ts",
      "import": "./dist/coinmarketcap.js",
      "default": "./dist/coinmarketcap.js"
    },
    "./prices": {
      "types": "./dist/prices.d.ts",
      "import": "./dist/prices.js",
      "default": "./dist/prices.js"
    },
    "./cctp": {
      "types": "./dist/cctp.d.ts",
      "import": "./dist/cctp.js",
      "default": "./dist/cctp.js"
    },
    "./zk-compression": {
      "types": "./dist/zk-compression.d.ts",
      "import": "./dist/zk-compression.js",
      "default": "./dist/zk-compression.js"
    },
    "./protocols": {
      "types": "./dist/protocols.d.ts",
      "import": "./dist/protocols.js",
      "default": "./dist/protocols.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.21.0 <12"
  }
}
