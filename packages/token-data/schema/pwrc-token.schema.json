{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PowerChain PWRC public payload",
  "type": "object",
  "required": [
    "token",
    "feePolicy",
    "source",
    "schemaVersion",
    "updatedAt"
  ],
  "properties": {
    "token": {
      "type": "object",
      "required": [
        "id",
        "name",
        "symbol",
        "version",
        "chain",
        "cluster",
        "tokenStandard",
        "tokenProgramId",
        "decimals",
        "totalSupplyTokens",
        "totalSupplyBaseUnits",
        "deploymentStatus",
        "mintAddress",
        "metadataAddress",
        "enabledExtensions",
        "disabledExtensions",
        "authorities"
      ],
      "properties": {
        "id": {
          "const": "pwrc"
        },
        "name": {
          "const": "PowerChain"
        },
        "symbol": {
          "const": "PWRC"
        },
        "version": {
          "const": "1.0.0"
        },
        "chain": {
          "const": "solana"
        },
        "cluster": {
          "const": "mainnet-beta"
        },
        "tokenStandard": {
          "const": "SPL Token-2022"
        },
        "tokenProgramId": {
          "type": "string"
        },
        "decimals": {
          "const": 9
        },
        "totalSupplyTokens": {
          "const": "18446000000"
        },
        "totalSupplyBaseUnits": {
          "const": "18446000000000000000"
        },
        "deploymentStatus": {
          "enum": [
            "configuration-ready",
            "deployed-unverified",
            "verified"
          ]
        },
        "mintAddress": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadataAddress": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabledExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "disabledExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "authorities": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "feePolicy": {
      "type": "object"
    },
    "source": {
      "const": "powerchain-token-data"
    },
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
