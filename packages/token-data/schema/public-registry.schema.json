{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PowerChain Public Data Registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "kind",
    "generatedAt",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "const": "powerchain"
    },
    "kind": {
      "const": "powerchain-public-registry"
    },
    "generatedAt": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "version",
        "product",
        "release",
        "chain",
        "cluster",
        "tokens"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "product": {
          "const": "PowerChain Launchpad"
        },
        "release": {
          "const": "1.0.0"
        },
        "chain": {
          "const": "solana"
        },
        "cluster": {
          "const": "mainnet-beta"
        },
        "tokens": {
          "type": "object",
          "required": [
            "PWRC"
          ]
        }
      }
    }
  }
}
