{
  "openapi": "3.1.0",
  "info": {
    "title": "PowerChain Launchpad Public Data API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/token": {
      "get": {
        "operationId": "getPwrcToken",
        "responses": {
          "200": {
            "description": "Canonical PWRC public token data"
          }
        }
      }
    },
    "/api/v1/public-data": {
      "get": {
        "operationId": "getPublicDataRegistry",
        "responses": {
          "200": {
            "description": "Canonical public data registry"
          },
          "304": {
            "description": "Not modified"
          }
        }
      }
    },
    "/api/v1/public-data/health": {
      "get": {
        "operationId": "getPublicDataHealth",
        "responses": {
          "200": {
            "description": "Public data healthy"
          },
          "503": {
            "description": "Public data validation failed"
          }
        }
      }
    },
    "/api/v1/public-data/meta": {
      "get": {
        "operationId": "getPublicDataMeta",
        "responses": {
          "200": {
            "description": "Public data metadata"
          }
        }
      }
    },
    "/api/v1/public-data/integrity": {
      "get": {
        "operationId": "getPublicDataIntegrity",
        "responses": {
          "200": {
            "description": "Public data SHA-256 fingerprints"
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "operationId": "getVersion",
        "responses": {
          "200": {
            "description": "PowerChain release and schema versions"
          }
        }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "responses": {
          "200": {
            "description": "PowerChain runtime capabilities"
          }
        }
      }
    },
    "/api/v1/readiness": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "PowerChain deployment readiness healthy"
          },
          "503": {
            "description": "PowerChain deployment readiness blocked"
          }
        }
      }
    },
    "/api/v1/runtime/persistence/health": {
      "get": {
        "operationId": "getRuntimePersistenceHealth",
        "responses": {
          "200": {
            "description": "Runtime persistence healthy"
          },
          "503": {
            "description": "Runtime persistence unavailable"
          }
        }
      }
    },
    "/api/v1/mutations/{mutationId}": {
      "get": {
        "operationId": "getMutationStatus",
        "parameters": [
          {
            "name": "mutationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mutation receipt"
          },
          "400": {
            "description": "Invalid mutation ID"
          },
          "404": {
            "description": "Mutation receipt not found"
          }
        }
      }
    },
    "/api/v1/runtime/mutations/{mutationId}/recovery": {
      "get": {
        "operationId": "getMutationRecoveryState",
        "parameters": [
          {
            "name": "mutationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mutation recovery inspection"
          },
          "400": {
            "description": "Invalid mutation ID"
          }
        }
      }
    },
    "/api/v1/settlements/{settlementId}": {
      "get": {
        "operationId": "getSettlement",
        "parameters": [
          {
            "name": "settlementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Settlement record"
          },
          "400": {
            "description": "Invalid settlement ID"
          },
          "404": {
            "description": "Settlement not found"
          }
        }
      }
    }
  }
}
