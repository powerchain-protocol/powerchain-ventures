{
  "name": "powerchain-ventures",
  "private": true,
  "version": "1.7.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "env:setup": "node scripts/setup-env.mjs",
    "dev": "turbo run dev --parallel",
    "dev:frontend": "pnpm --filter @powerchain/frontend dev",
    "dev:marketplace": "pnpm --filter @powerchain/marketplace dev",
    "dev:backend": "pnpm --filter @powerchain/api dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "check": "pnpm typecheck && pnpm build",
    "clean": "find apps packages -type d \\( -name .next -o -name dist \\) -prune -exec rm -rf {} + && rm -rf programs/target",
    "db:generate": "pnpm --filter @powerchain/api prisma:generate",
    "db:migrate": "pnpm --filter @powerchain/api prisma:migrate",
    "db:deploy": "pnpm --filter @powerchain/api prisma:deploy",
    "db:studio": "pnpm --filter @powerchain/api prisma:studio",
    "db:seed": "pnpm --filter @powerchain/api prisma:seed",
    "deploy:cloudflare": "pnpm --filter @powerchain/frontend deploy && pnpm --filter @powerchain/marketplace deploy",
    "preview:cloudflare": "pnpm --filter @powerchain/frontend preview",
    "dev:api": "pnpm --filter @powerchain/api dev",
    "program:check": "cargo check --manifest-path programs/Cargo.toml",
    "program:test": "cargo test --manifest-path programs/Cargo.toml",
    "validate": "pnpm typecheck && pnpm program:check"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  }
}
