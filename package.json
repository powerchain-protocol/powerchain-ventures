{
  "name": "powerchain-launchpad",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.21.0 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @powerchain/launchpad-backend --filter @powerchain/launchpad-frontend --filter @powerchain/launchpad-checkout dev",
    "build": "pnpm build:packages && pnpm prisma:generate && pnpm --filter @powerchain/launchpad-backend build && pnpm --filter @powerchain/launchpad-frontend build && pnpm --filter @powerchain/launchpad-checkout build",
    "typecheck": "pnpm typecheck:packages && pnpm typecheck:apps",
    "test": "pnpm build:packages && node --test tests/*.test.mjs && pnpm test:utils",
    "validate": "node scripts/check-workspace.mjs && node scripts/validate.mjs && node scripts/check-pnpm-policy.mjs && node scripts/check-vercel-config.mjs && node scripts/check-env-example.mjs && node scripts/check-app-env-files.mjs && node scripts/check-mobile-env-example.mjs && node scripts/check-mobile-native.mjs && node scripts/sync-openapi.mjs --check && pnpm build:packages && node --test tests/*.test.mjs && pnpm test:utils",
    "dev:all": "pnpm --parallel --filter @powerchain/launchpad-backend --filter @powerchain/launchpad-frontend --filter @powerchain/launchpad-checkout dev",
    "build:frontend": "pnpm --filter @powerchain/launchpad-frontend build",
    "build:backend": "pnpm --filter @powerchain/launchpad-backend build",
    "start:frontend": "pnpm --filter @powerchain/launchpad-frontend start",
    "start:backend": "pnpm --filter @powerchain/launchpad-backend start",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "preflight:production": "node scripts/check-production-env.mjs",
    "validate:vercel": "node scripts/check-vercel-config.mjs",
    "validate:env-example": "node scripts/check-env-example.mjs",
    "setup": "pnpm corepack:enable && pnpm install && pnpm doctor:pnpm && pnpm prisma:generate && pnpm doctor:workspace && pnpm doctor:types",
    "doctor:types": "node scripts/check-type-deps.mjs",
    "pretypecheck": "pnpm build:packages && pnpm prisma:generate && node scripts/check-type-deps.mjs",
    "types:frontend": "pnpm --filter @powerchain/launchpad-frontend typecheck",
    "types:backend": "pnpm --filter @powerchain/launchpad-backend typecheck",
    "corepack:enable": "corepack enable && corepack prepare pnpm@11.21.0 --activate",
    "telemetry:disable": "pnpm --filter @powerchain/launchpad-frontend exec next telemetry disable && pnpm --filter @powerchain/launchpad-backend exec next telemetry disable && pnpm --filter @powerchain/launchpad-checkout exec next telemetry disable",
    "build:packages": "pnpm --filter @powerchain/launchpad-config --filter @powerchain/launchpad-domain --filter @powerchain/solana --filter @powerchain/utils --filter @powerchain/integrations --filter @powerchain/launchpad-program-client --filter @powerchain/mail --filter @powerchain/ui build",
    "peers:check": "pnpm peers check",
    "dev:frontend": "pnpm --filter @powerchain/launchpad-frontend dev",
    "dev:backend": "pnpm --filter @powerchain/launchpad-backend dev",
    "start": "pnpm --parallel --filter @powerchain/launchpad-backend --filter @powerchain/launchpad-frontend --filter @powerchain/launchpad-checkout start",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "db:generate": "pnpm prisma:generate",
    "db:validate": "pnpm prisma:validate",
    "openapi:sync": "node scripts/sync-openapi.mjs",
    "openapi:check": "node scripts/sync-openapi.mjs --check",
    "program:check": "cargo check --manifest-path programs/Cargo.toml -p powerchain-launchpad-program",
    "program:build": "cargo build-sbf --manifest-path programs/Cargo.toml -p powerchain-launchpad-program",
    "program:test": "cargo test --manifest-path programs/Cargo.toml -p powerchain-launchpad-program",
    "doctor:pnpm": "node scripts/check-pnpm-policy.mjs",
    "dev:mobile": "pnpm --filter @powerchain/launchpad-mobile dev",
    "mobile:start": "pnpm --filter @powerchain/launchpad-mobile start",
    "mobile:ios": "pnpm --filter @powerchain/launchpad-mobile ios",
    "mobile:android": "pnpm --filter @powerchain/launchpad-mobile android",
    "mobile:prebuild": "pnpm --filter @powerchain/launchpad-mobile prebuild",
    "mobile:doctor": "pnpm --filter @powerchain/launchpad-mobile doctor",
    "mobile:typecheck": "pnpm --filter @powerchain/launchpad-mobile typecheck",
    "validate:mobile-env": "node scripts/check-mobile-env-example.mjs",
    "mobile:validate:native": "node scripts/check-mobile-native.mjs",
    "dev:web": "pnpm --parallel --filter @powerchain/launchpad-backend --filter @powerchain/launchpad-frontend --filter @powerchain/launchpad-checkout dev",
    "dev:all-apps": "pnpm --parallel --filter @powerchain/launchpad-backend --filter @powerchain/launchpad-frontend --filter @powerchain/launchpad-checkout --filter @powerchain/launchpad-mobile dev",
    "debug:frontend": "pnpm --filter @powerchain/launchpad-frontend dev",
    "debug:backend": "pnpm --filter @powerchain/launchpad-backend dev",
    "debug:mobile": "pnpm --filter @powerchain/launchpad-mobile dev",
    "mobile:doctor:ios": "pnpm --filter @powerchain/launchpad-mobile doctor:ios",
    "mobile:config": "pnpm --filter @powerchain/launchpad-mobile exec expo config --type public",
    "mobile:scheme:test:ios": "pnpm --filter @powerchain/launchpad-mobile exec uri-scheme open powerchain:// --ios",
    "mobile:scheme:test:android": "pnpm --filter @powerchain/launchpad-mobile exec uri-scheme open powerchain:// --android",
    "typecheck:packages": "pnpm --filter @powerchain/launchpad-config --filter @powerchain/launchpad-domain --filter @powerchain/solana --filter @powerchain/utils --filter @powerchain/integrations --filter @powerchain/launchpad-program-client --filter @powerchain/mail --filter @powerchain/ui typecheck",
    "typecheck:apps": "pnpm --filter @powerchain/launchpad-backend typecheck && pnpm --filter @powerchain/launchpad-frontend typecheck && pnpm --filter @powerchain/launchpad-checkout typecheck && pnpm --filter @powerchain/launchpad-mobile typecheck",
    "doctor:workspace": "node scripts/check-workspace.mjs",
    "mobile:bootstrap": "pnpm --filter @powerchain/launchpad-mobile bootstrap",
    "mobile:clean": "pnpm --filter @powerchain/launchpad-mobile clean",
    "mobile:check:install": "pnpm --filter @powerchain/launchpad-mobile check:install",
    "doctor:frontend": "node scripts/check-frontend-resolution.mjs",
    "repair:workspace": "pnpm install --force --no-frozen-lockfile && pnpm doctor:workspace && pnpm doctor:types && pnpm doctor:frontend",
    "test:utils": "pnpm --filter @powerchain/utils test",
    "doctor:runtime": "node scripts/check-runtime-toolchain.mjs",
    "clean:next": "node scripts/clean-next-cache.mjs all",
    "clean:frontend": "node scripts/clean-next-cache.mjs frontend",
    "clean:backend": "node scripts/clean-next-cache.mjs backend",
    "preflight:frontend": "node scripts/check-dev-start.mjs frontend",
    "preflight:backend": "node scripts/check-dev-start.mjs backend",
    "dev:frontend:direct": "node scripts/run-next.mjs frontend dev",
    "dev:backend:direct": "node scripts/run-next.mjs backend dev",
    "preinstall": "node scripts/check-install-runtime.mjs",
    "validate:app-envs": "node scripts/check-app-env-files.mjs",
    "docs:check": "node scripts/check-documentation.mjs",
    "test:repo": "node --test tests/*.test.mjs",
    "test:contracts": "pnpm --filter @powerchain/token-data test",
    "quality:source": "node scripts/check-monorepo-layout.mjs && node scripts/check-documentation.mjs && node scripts/check-branding.mjs && node scripts/check-workspace.mjs && node scripts/check-pnpm-policy.mjs && node scripts/check-vercel-config.mjs && node scripts/check-env-example.mjs && node scripts/check-app-env-files.mjs && node scripts/check-mobile-env-example.mjs && node scripts/check-mobile-native.mjs && node scripts/check-runtime-module-resolution.mjs && node scripts/check-frontend-architecture.mjs && node scripts/check-api-transport.mjs && node scripts/sync-openapi.mjs --check && node --test tests/*.test.mjs && node scripts/check-auth-wallet-upgrade.mjs && node scripts/check-runtime-persistence-source.mjs && node scripts/check-settlement-worker.mjs && node scripts/check-workspace-boundaries.mjs && node scripts/check-program-parity.mjs && node scripts/check-local-transaction-builders.mjs && node scripts/check-payment-protocols.mjs",
    "test:repo:source": "node --test tests/*.test.mjs",
    "doctor:runtime-resolution": "node scripts/check-runtime-module-resolution.mjs",
    "env:rpc:check": "node scripts/check-rpc-environment.mjs",
    "env:production:check": "node scripts/check-production-env.mjs",
    "doctor:env": "node scripts/check-env-example.mjs && node scripts/check-app-env-files.mjs && node scripts/check-mobile-env-example.mjs && node scripts/check-rpc-environment.mjs",
    "branding:check": "node scripts/check-branding.mjs",
    "mail:typecheck": "pnpm --filter @powerchain/mail typecheck",
    "doctor:frontend-architecture": "node scripts/check-frontend-architecture.mjs",
    "doctor:api-transport": "node scripts/check-api-transport.mjs",
    "doctor:auth-wallet": "node scripts/check-auth-wallet-upgrade.mjs",
    "auth:schema:generate": "pnpm exec auth generate --config apps/backend/lib/better-auth.ts",
    "doctor:auth-deps": "node scripts/check-auth-wallet-dependencies.mjs",
    "doctor:account": "node scripts/check-auth-wallet-upgrade.mjs",
    "build:checkout": "pnpm --filter @powerchain/launchpad-checkout build",
    "dev:checkout": "pnpm --filter @powerchain/launchpad-checkout dev",
    "start:checkout": "pnpm --filter @powerchain/launchpad-checkout start",
    "preflight:checkout": "node scripts/check-dev-start.mjs checkout",
    "clean:checkout": "node scripts/clean-next-cache.mjs checkout",
    "types:checkout": "pnpm --filter @powerchain/launchpad-checkout typecheck",
    "doctor:layout": "node scripts/check-monorepo-layout.mjs",
    "runtime:persistence:health": "node scripts/check-runtime-persistence-source.mjs",
    "doctor:settlement-worker": "node scripts/check-settlement-worker.mjs",
    "doctor:workspace-boundaries": "node scripts/check-workspace-boundaries.mjs",
    "doctor:program-parity": "node scripts/check-program-parity.mjs",
    "doctor:local-builders": "node scripts/check-local-transaction-builders.mjs",
    "doctor:payment-protocols": "node scripts/check-payment-protocols.mjs"
  },
  "devDependencies": {
    "next": "16.2.12",
    "typescript": "5.9.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "7.9.1"
  },
  "type": "module"
}
