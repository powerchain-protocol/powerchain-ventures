# PowerChain Launchpad frontend
# Browser-safe values only. Never put Helius/API secrets here.

NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_ORIGIN=http://localhost:3001
BACKEND_FALLBACK_ORIGINS=
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
NEXT_PUBLIC_SOLANA_RPC_URL=http://localhost:3001/api/v1/solana/rpc
POWERCHAIN_STRICT_BUILD_ENV=0

# Optional browser-safe WebSocket endpoint. Never put a private Helius API key here.
NEXT_PUBLIC_SOLANA_WS_URL=

NEXT_PUBLIC_EMBEDDED_WALLET_PROVIDER=disabled

# Release top bar. Set false to hide without editing UI code.
NEXT_PUBLIC_TOPBAR_ENABLED=true

# Public Sui gRPC endpoints used by Mysten dApp Kit
NEXT_PUBLIC_SUI_GRPC_URL=https://fullnode.mainnet.sui.io:443
NEXT_PUBLIC_SUI_TESTNET_GRPC_URL=https://fullnode.testnet.sui.io:443

NEXT_PUBLIC_CHECKOUT_URL=http://localhost:3002

# Browser-safe payment feature flags
NEXT_PUBLIC_SOLANA_PAY_ENABLED=1
NEXT_PUBLIC_COINBASE_ONRAMP_ENABLED=0
NEXT_PUBLIC_STRIPE_ENABLED=0
NEXT_PUBLIC_USDC_PURCHASE_ENABLED=0
NEXT_PUBLIC_CCTP_ENABLED=0
NEXT_PUBLIC_SUI_PURCHASE_ENABLED=0
NEXT_PUBLIC_ZK_COMPRESSION_ENABLED=0
