{
  "name": "@powerchain/launchpad-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/run-next.mjs frontend dev",
    "build": "node ../../scripts/run-next.mjs frontend build",
    "start": "node ../../scripts/run-next.mjs frontend start",
    "typecheck": "tsc --noEmit",
    "predev": "node ../../scripts/check-dev-start.mjs frontend && pnpm -C ../.. build:packages && node ../../scripts/check-frontend-resolution.mjs",
    "prebuild": "pnpm -C ../.. build:packages && node ../../scripts/check-frontend-resolution.mjs"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@solana/connector": "0.2.6",
    "@solana/web3.js": "1.98.4",
    "@powerchain/launchpad-config": "workspace:*",
    "@powerchain/utils": "workspace:*"
  },
  "devDependencies": {
    "@next/env": "16.2.12",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.21.0 <12"
  }
}
