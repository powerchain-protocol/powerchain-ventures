{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@powerchain/utils": [
        "../../packages/utils/dist/index.d.ts"
      ],
      "@powerchain/utils/helpers": [
        "../../packages/utils/dist/helpers.d.ts"
      ],
      "@powerchain/utils/http": [
        "../../packages/utils/dist/http.d.ts"
      ],
      "@powerchain/utils/utils/errors": [
        "../../packages/utils/dist/utils/errors.d.ts"
      ],
      "@powerchain/launchpad-config/constants": [
        "../../packages/config/dist/constants.d.ts"
      ]
    },
    "types": [
      "node",
      "react",
      "react-dom"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ]
}
