NEXT_PUBLIC_USDC_PURCHASE_ENABLED=0
NEXT_PUBLIC_CCTP_ENABLED=0
NEXT_PUBLIC_SUI_PURCHASE_ENABLED=0
NEXT_PUBLIC_ZK_COMPRESSION_ENABLED=0
