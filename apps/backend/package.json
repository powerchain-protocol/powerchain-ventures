{
  "name": "@powerchain/launchpad-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/run-next.mjs backend build",
    "typecheck": "tsc --noEmit",
    "dev": "node ../../scripts/run-next.mjs backend dev",
    "start": "node ../../scripts/run-next.mjs backend start",
    "predev": "node ../../scripts/check-dev-start.mjs backend && pnpm -C ../.. build:packages"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@powerchain/solana": "workspace:*",
    "@powerchain/launchpad-config": "workspace:*",
    "@solana/web3.js": "1.98.4",
    "@solana/spl-token": "0.4.14",
    "@powerchain/utils": "workspace:*",
    "@coinbase/cdp-sdk": "1.45.0",
    "@powerchain/integrations": "workspace:*",
    "@prisma/client": "7.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "pg": "8.16.3",
    "@powerchain/launchpad-program-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "5.9.3"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.21.0 <12"
  }
}
