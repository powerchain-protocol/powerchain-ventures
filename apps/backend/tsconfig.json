{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "noEmit": true,
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "baseUrl": ".",
    "paths": {
      "@powerchain/launchpad-config": [
        "../../packages/config/dist/index.d.ts"
      ],
      "@powerchain/utils": [
        "../../packages/utils/dist/index.d.ts"
      ],
      "@powerchain/solana": [
        "../../packages/solana/dist/index.d.ts"
      ],
      "@powerchain/launchpad-domain": [
        "../../packages/domain/dist/index.d.ts"
      ],
      "@powerchain/integrations": [
        "../../packages/integrations/dist/index.d.ts"
      ],
      "@powerchain/launchpad-program-client": [
        "../../packages/program-client/dist/index.d.ts"
      ],
      "@powerchain/utils/helpers": [
        "../../packages/utils/dist/helpers.d.ts"
      ],
      "@powerchain/utils/http": [
        "../../packages/utils/dist/http.d.ts"
      ],
      "@powerchain/utils/utils/errors": [
        "../../packages/utils/dist/utils/errors.d.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ]
}
