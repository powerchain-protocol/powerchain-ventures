# PowerChain production mainnet-beta profile
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://launchpad.powerchain.energy
BACKEND_ORIGIN=https://backend.powerchain.energy
ALLOWED_ORIGINS=https://launchpad.powerchain.energy,https://checkout.powerchain.energy

NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
NEXT_PUBLIC_SOLANA_RPC_URL=https://backend.powerchain.energy/api/v1/solana/rpc

SOLANA_RPC_PROVIDER=helius
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/
HELIUS_API_URL=https://api.helius.xyz

# Configure at least one independent dedicated fallback for production.
CUSTOM_SOLANA_RPC_URL=
CUSTOM_SOLANA_RPC_FALLBACK_URLS=

# Legacy variables remain supported but custom/Helius variables are preferred.
SOLANA_RPC_URL=
SOLANA_RPC_FALLBACK_URL=
SOLANA_RPC_FALLBACK_URLS=
SOLANA_EXPECTED_GENESIS_PREFIX=5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp

POWERCHAIN_STRICT_BUILD_ENV=1
POWERCHAIN_TREASURY_WALLET=FeeszhrKKEsvxr1kg8LDtPx6BLcEbYHiAThYaxajNhqy
POWERCHAIN_LAUNCHPAD_PROGRAM_ID=
POWERCHAIN_QUOTE_AUTHORITY_WALLET=
POWERCHAIN_PRESALE_MINT=
POWERCHAIN_PRESALE_VAULT_TOKEN_ACCOUNT=
POWERCHAIN_PRESALE_VAULT_AUTHORITY=

DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional external builder for delegated vault-authority sale activation only.
POWERCHAIN_DELEGATED_VAULT_ACTIVATION_ENABLED=0
POWERCHAIN_TRANSACTION_BUILDER_URL=
POWERCHAIN_TRANSACTION_BUILDER_API_KEY=
CRON_SECRET=
RECONCILIATION_SECRET=

# Mail
MAIL_PROVIDER=disabled
MAIL_FROM=PowerChain Launchpad <no-reply@powerchain.energy>
MAIL_CONTACT_TO=support@powerchain.energy
RESEND_API_KEY=

# WebSocket transport
CUSTOM_SOLANA_WS_URLS=
SOLANA_WS_URL=

# Better Auth
BETTER_AUTH_ENABLED=true
BETTER_AUTH_SECRET=
AUTH_DB_POOL_SIZE=5

# Social login providers (server-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Embedded wallet adapter selection
EMBEDDED_WALLET_PROVIDER=disabled

# Optional Sui settlement adapter
POWERCHAIN_SUI_PAYMENTS_ENABLED=false
SUI_RPC_URL=


# Market data / price aggregation (server-only)
PYTH_API_KEY=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_SOL_USD_FEED_ID=
PYTH_USDC_USD_FEED_ID=
PYTH_SUI_USD_FEED_ID=

BIRDEYE_API_KEY=
BIRDEYE_BASE_URL=https://public-api.birdeye.so

# Optional fallback provider. Required if CoinMarketCap is enabled.
COINMARKETCAP_API_KEY=
COINMARKETCAP_BASE_URL=https://pro-api.coinmarketcap.com

PRICE_MAX_AGE_MS=90000
PRICE_MAX_DIVERGENCE_BPS=300


# Server-only quote authority signer.
# JSON array of exactly 64 byte values. Never expose to frontend/checkout.
POWERCHAIN_QUOTE_AUTHORITY_KEYPAIR_JSON=
NEXT_PUBLIC_CHECKOUT_URL=https://checkout.powerchain.energy


# Durable runtime persistence and settlement finality
POWERCHAIN_RUNTIME_PERSISTENCE=database
SETTLEMENT_WORKER_BATCH_SIZE=50
SETTLEMENT_OUTBOX_FAILED_TOLERANCE=0
SETTLEMENT_OUTBOX_MAX_PENDING_AGE_MS=300000

# Payments, Solana Pay and protocol capabilities
POWERCHAIN_SOLANA_PAY_ENABLED=1
POWERCHAIN_COINBASE_ONRAMP_ENABLED=0
POWERCHAIN_STRIPE_ENABLED=0
STRIPE_HOSTED_CHECKOUT_URL=
POWERCHAIN_USDC_PURCHASE_ENABLED=0
POWERCHAIN_CCTP_ENABLED=0
CCTP_ENVIRONMENT=mainnet
CIRCLE_API_KEY=
POWERCHAIN_SUI_PURCHASE_ENABLED=0
POWERCHAIN_ZK_COMPRESSION_ENABLED=0
ZK_COMPRESSION_RPC_URL=
PYTH_CORE_GENERATION=upgraded
PYTH_SOLANA_RECEIVER_PROGRAM_ID=rec2HHDDnjLfj4kE7VyEtFA1HPGQLK33259532cRyHp
PYTH_SOLANA_PRICE_FEED_PROGRAM_ID=pyt2F414BA6dPttK6RddPZUdHfapoBN24GL5wbrPCou
PYTH_SOLANA_WORMHOLE_RECEIVER_PROGRAM_ID=HDw2E7P8X1SkCyjvoGsfBGAVUutKcj874bXjHrpVYrVL
NEXT_PUBLIC_SOLANA_PAY_ENABLED=1
NEXT_PUBLIC_COINBASE_ONRAMP_ENABLED=0
NEXT_PUBLIC_STRIPE_ENABLED=0
NEXT_PUBLIC_USDC_PURCHASE_ENABLED=0
NEXT_PUBLIC_CCTP_ENABLED=0
NEXT_PUBLIC_SUI_PURCHASE_ENABLED=0
NEXT_PUBLIC_ZK_COMPRESSION_ENABLED=0
