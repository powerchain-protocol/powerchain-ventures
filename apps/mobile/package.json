{
  "name": "@powerchain/launchpad-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start --scheme powerchain",
    "dev": "EXPO_NO_TELEMETRY=1 expo start --dev-client --scheme powerchain",
    "ios": "EXPO_NO_TELEMETRY=1 expo run:ios",
    "android": "EXPO_NO_TELEMETRY=1 expo run:android",
    "prebuild": "EXPO_NO_TELEMETRY=1 expo prebuild",
    "prebuild:clean": "EXPO_NO_TELEMETRY=1 expo prebuild --clean",
    "typecheck": "node ../../scripts/check-mobile-toolchain.mjs --typescript && tsc --noEmit",
    "doctor": "node ../../scripts/check-mobile-toolchain.mjs && pnpm exec expo-doctor",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "validate:native": "node ../../scripts/check-mobile-native.mjs",
    "doctor:ios": "node ../../scripts/check-mobile-toolchain.mjs --ios",
    "bootstrap": "cd ../.. && pnpm install --no-frozen-lockfile && pnpm --filter @powerchain/launchpad-mobile exec expo install --fix && pnpm --filter @powerchain/launchpad-mobile doctor",
    "clean": "node ../../scripts/clean-mobile.mjs",
    "check:install": "node ../../scripts/check-mobile-install.mjs",
    "prestart": "node ../../scripts/check-mobile-install.mjs",
    "predev": "node ../../scripts/check-mobile-install.mjs",
    "preios": "node ../../scripts/check-mobile-install.mjs",
    "preandroid": "node ../../scripts/check-mobile-install.mjs"
  },
  "dependencies": {
    "expo": "~57.0.12",
    "expo-router": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.0",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0",
    "@supabase/supabase-js": "2.111.0",
    "@powerchain/launchpad-config": "workspace:*",
    "@powerchain/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "5.9.3",
    "babel-preset-expo": "~57.0.0",
    "@types/node": "^22",
    "expo-doctor": "1.20.1"
  }
}
