# PowerChain Launchpad mobile — public/native-safe values only.
# Do NOT place Supabase service-role keys, Helius keys, Birdeye keys,
# Coinbase secrets, quote-authority keys, or transaction-builder secrets here.

EXPO_PUBLIC_API_URL=https://api.launchpad.example.com
EXPO_PUBLIC_API_TIMEOUT_MS=12000
EXPO_PUBLIC_WEB_URL=https://launchpad.example.com
EXPO_PUBLIC_APP_SCHEME=powerchain
EXPO_PUBLIC_EAS_PROJECT_ID=

# Public Solana identity. Use a browser/device-safe RPC without private provider credentials.
EXPO_PUBLIC_SOLANA_CLUSTER=mainnet-beta
EXPO_PUBLIC_SOLANA_RPC_URL=https://rpc-public.example.com

# Supabase Auth client values. The publishable key is designed for client use;
# RLS/backend authorization remain mandatory.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Native identifiers are read at prebuild time; configure them in EAS/project env.
IOS_BUNDLE_IDENTIFIER=com.powerchain.launchpad
ANDROID_PACKAGE_NAME=com.powerchain.launchpad

# Optional mobile behavior flags (public-safe)
EXPO_PUBLIC_ENABLE_ONBOARDING=true
EXPO_PUBLIC_ENABLE_CREATOR=true
EXPO_PUBLIC_ENABLE_COINBASE_ONRAMP=true
