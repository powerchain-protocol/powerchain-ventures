FROM node:24-alpine AS base
WORKDIR /app
RUN corepack enable

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/checkout/package.json apps/checkout/package.json
COPY packages packages
RUN corepack prepare pnpm@11.21.0 --activate \
 && pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm build:packages \
 && pnpm --filter @powerchain/launchpad-checkout build

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app/apps/checkout/.next/standalone ./
COPY --from=build /app/apps/checkout/.next/static ./apps/checkout/.next/static
EXPOSE 3002
CMD ["node", "apps/checkout/server.js"]
